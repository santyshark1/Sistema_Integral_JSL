<UserControl x:Class="JSL_SentinelPro.src.UI.Views.EmpresasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Empresas Asociadas" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <Button Content="Ver citas gestionadas" Command="{Binding ToggleAppointmentsCommand}" Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Left" Margin="0,0,0,12"/>

            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16"
                    Visibility="{Binding ShowAppointments, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Citas Gestionadas" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding Appointments}" Style="{StaticResource DataGridBase}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding RequestedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
                            <DataGridTextColumn Header="Empresa" Binding="{Binding CompanyName}" Width="190"/>
                            <DataGridTextColumn Header="Ciudad" Binding="{Binding City}" Width="110"/>
                            <DataGridTextColumn Header="Especialidad" Binding="{Binding Specialty}" Width="180"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="220"/>
                            <DataGridTextColumn Header="Contacto" Binding="{Binding Contact}" Width="240"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Filtros -->
            <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ciudad:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Cities}" SelectedValue="{Binding SelectedCity}" Width="140" Margin="0,0,12,0" Style="{StaticResource ComboBoxBase}"/>
                    <TextBlock Text="Especialidad:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Specialties}" SelectedValue="{Binding SelectedSpecialty}" Width="180" Margin="0,0,12,0" Style="{StaticResource ComboBoxBase}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Style="{StaticResource TextBoxBase}" Margin="0,0,12,0" ToolTip="Buscar por nombre, ciudad, especialidad o direccion"/>
                    <Button Content="Limpiar" Command="{Binding ClearFiltersCommand}" Style="{StaticResource ButtonSecondary}"/>
                </StackPanel>
            </Border>

            <!-- Grid de empresas -->
            <ItemsControl ItemsSource="{Binding FilteredPartners}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="8">
                            <StackPanel>
                                <Border Width="64" Height="64" Background="{StaticResource PrimaryLightBrush}" CornerRadius="6,6,6,6" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Name, Converter={StaticResource NameToInitialsConverter}}" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Specialty}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,2"/>
                                <TextBlock Text="{Binding City}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,2"/>
                                <TextBlock Text="{Binding Rating, StringFormat='⭐ {0:F1}'}" FontSize="12" TextAlignment="Center" Margin="0,4"/>
                                <TextBlock Text="{Binding IsAvailable, Converter={StaticResource BoolToAvailableTextConverter}}" FontSize="11" TextAlignment="Center" Margin="0,2"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Button Content="Agendar" Command="{Binding DataContext.ScheduleAppointmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource ButtonPrimary}" Padding="8,4" FontSize="11" Margin="2"/>
                                    <Button Content="Contactar" Command="{Binding DataContext.ContactCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource ButtonSecondary}" Padding="8,4" FontSize="11" Margin="2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
