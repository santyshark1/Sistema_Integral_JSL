<UserControl x:Class="JSL_SentinelPro.src.UI.Views.PasswordResetConfirmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
            <TextBlock Text="JSL" FontSize="36" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="SISTEMA INTEGRAL DE SEGURIDAD" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,20"/>

            <Border Style="{StaticResource CardStyle}" Padding="32">
                <StackPanel>
                    <TextBlock Text="Ingresa el codigo de recuperacion" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Hemos enviado un codigo de 6 caracteres a tu correo electronico." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="Correo electronico" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxBase}" Margin="0,0,0,12"/>

                    <TextBlock Text="Codigo de recuperacion" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxBase}" Margin="0,0,0,12" MaxLength="6" CharacterCasing="Upper"/>

                    <TextBlock Text="Nueva contrasena" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="NewPwd" Style="{StaticResource PasswordBoxBase}" Margin="0,0,0,10" PasswordChanged="NewPwd_PasswordChanged"/>

                    <TextBlock Text="Confirmar nueva contrasena" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="ConfirmPwd" Style="{StaticResource PasswordBoxBase}" Margin="0,0,0,12" PasswordChanged="ConfirmPwd_PasswordChanged"/>

                    <TextBlock Text="{Binding Message}" Foreground="{Binding IsSuccess, Converter={StaticResource BoolToBrushConverter}}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Button Content="Restablecer contrasena" Command="{Binding ResetPasswordCommand}" Style="{StaticResource ButtonPrimary}" Margin="0,0,0,8" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Hyperlink Command="{Binding ResendCodeCommand}">
                            <TextBlock Text="¿No recibiste el codigo? Reenviar" FontSize="12" Foreground="{StaticResource PrimaryBrush}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Hyperlink Command="{Binding NavigateToLoginCommand}">
                            <TextBlock Text="← Volver al inicio de sesion" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
