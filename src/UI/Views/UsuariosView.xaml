<UserControl x:Class="JSL_SentinelPro.src.UI.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Gestion de Usuarios" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Lista -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Nuevo Usuario" Command="{Binding NewUserCommand}" Style="{StaticResource ButtonPrimary}" Margin="0,0,8,0" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Content="Actualizar" Command="{Binding LoadUsersCommand}" Style="{StaticResource ButtonSecondary}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" Style="{StaticResource DataGridBase}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="120"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                            <DataGridTextColumn Header="Rol" Binding="{Binding AccountType}" Width="120"/>
                            <DataGridTextColumn Header="Ultimo Login" Binding="{Binding LastLogin, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
                            <DataGridTemplateColumn Header="Acciones" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Eliminar" Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Style="{StaticResource ButtonSecondary}" Padding="8,2" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Edicion -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Editar Usuario" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Nombre completo" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditFullName}" Style="{StaticResource TextBoxBase}" Margin="0,0,0,8"/>
                    <TextBlock Text="Correo" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditEmail}" Style="{StaticResource TextBoxBase}" Margin="0,0,0,8"/>
                    <TextBlock Text="Rol" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding EditAccountType}" Style="{StaticResource ComboBoxBase}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Message}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                               Foreground="{Binding Message, Converter={StaticResource MessageToBrushConverter}}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Guardar" Command="{Binding SaveUserCommand}" Style="{StaticResource ButtonPrimary}" Margin="0,0,8,0"/>
                        <Button Content="Cancelar" Command="{Binding CancelEditCommand}" Style="{StaticResource ButtonSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
