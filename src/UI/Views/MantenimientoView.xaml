<UserControl x:Class="JSL_SentinelPro.src.UI.Views.MantenimientoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Mantenimiento y Optimizacion" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
            <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,16"
                    Visibility="{Binding MaintenanceMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding MaintenanceMessage}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>

            <!-- Limpieza -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Limpieza del Sistema" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Archivos Temporales" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TempFilesGB, StringFormat='{}{0:F2} GB', Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Espacio Recuperable" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RecoverableSpaceGB, StringFormat='{}{0:F2} GB', Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Estado Almacenamiento" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding StorageStatus, Mode=OneWay}" FontSize="22" FontWeight="Bold"
                                       Foreground="{Binding StorageStatus, Converter={StaticResource StatusToBrushConverter}}"/>
                        </StackPanel>
                    </UniformGrid>
                    <ProgressBar Value="{Binding StoragePercent, Mode=OneWay}" Maximum="100" Height="10" Margin="0,0,0,12"/>

                    <TextBlock Text="Recomendaciones de limpieza" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding CleanupItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,4">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" - "/>
                                        <Run Text="{Binding SizeDisplay, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Run Text=" ["/><Run Text="{Binding Priority, Mode=OneWay}"/><Run Text="]"/>
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Limpiar Ahora" Command="{Binding CleanNowCommand}" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left"
                                IsEnabled="{Binding IsCleaning, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="Generar PDF" Command="{Binding GeneratePdfCommand}" Style="{StaticResource ButtonSecondary}" Margin="8,0,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4,0,0" Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding LastCleanupDate, StringFormat='Ultima limpieza: {0}', Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Optimizacion -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Optimizacion del Sistema" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Programas al Inicio" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding StartupProgramCount, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Rendimiento Estimado" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}">
                                <Run Text="+"/><Run Text="{Binding EstimatedPerformanceGain, StringFormat='{}{0:F0}', Mode=OneWay}"/><Run Text="%"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Salud Rendimiento" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding PerformanceHealth, Mode=OneWay}" FontSize="22" FontWeight="Bold"
                                       Foreground="{Binding PerformanceHealth, Converter={StaticResource StatusToBrushConverter}}"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Seleccione los ajustes que desea aplicar" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding OptimizationSettings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsRecommended}" IsEnabled="{Binding IsApplied, Converter={StaticResource InverseBoolConverter}}" Margin="0,4">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" - "/><Run Text="{Binding Description, Mode=OneWay}"/>
                                        <Run Text=" ["/><Run Text="{Binding Priority, Mode=OneWay}"/><Run Text="]"/>
                                        <Run Text=" (+"/><Run Text="{Binding EstimatedGainPercent, StringFormat='{}{0:F0}', Mode=OneWay}"/><Run Text="%)"/>
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Programas al inicio" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,8"/>
                    <TextBlock Text="Si marca Optimizar programas de inicio, desmarque aqui los programas que no quiere iniciar con Windows." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <DataGrid ItemsSource="{Binding StartupPrograms}" Style="{StaticResource DataGridBase}" AutoGenerateColumns="False" MaxHeight="180">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsEnabled}" Width="70"/>
                            <DataGridTextColumn Header="Programa" Binding="{Binding Name}" Width="180" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Impacto" Binding="{Binding Impact}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Ruta" Binding="{Binding Path}" Width="420" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Optimizar Ahora" Command="{Binding OptimizeNowCommand}" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left"
                                IsEnabled="{Binding IsOptimizing, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="Generar PDF" Command="{Binding GeneratePdfCommand}" Style="{StaticResource ButtonSecondary}" Margin="8,0,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4,0,0" Visibility="{Binding IsOptimizing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Historial -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Historial de Limpiezas" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding CleanupHistory}" Style="{StaticResource DataGridBase}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding ActionDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
                            <DataGridTextColumn Header="Espacio GB" Binding="{Binding SpaceFreedGB, StringFormat='{}{0:F2}'}" Width="100"/>
                            <DataGridTextColumn Header="Detalles" Binding="{Binding Details}" Width="420"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Historial de Optimizaciones" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,12"/>
                    <DataGrid ItemsSource="{Binding OptimizationHistory}" Style="{StaticResource DataGridBase}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding ActionDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
                            <DataGridTextColumn Header="Detalles" Binding="{Binding Details}" Width="560"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Consejo -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Background="{StaticResource InfoBackgroundBrush}">
                <StackPanel>
                    <TextBlock Text="💡 Consejo de Seguridad" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding SecurityTip, Mode=OneWay}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
