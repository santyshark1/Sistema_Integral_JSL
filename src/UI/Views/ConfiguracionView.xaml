<UserControl x:Class="JSL_SentinelPro.src.UI.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Configuracion" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Programacion y Tareas" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <CheckBox IsChecked="{Binding AutomaticScansEnabled}" Content="Escaneos automaticos" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Frecuencia:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding ScanFrequencies}" SelectedItem="{Binding ScanFrequency}" Width="160" Style="{StaticResource ComboBoxBase}"/>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding AutomaticMaintenanceEnabled}" Content="Mantenimiento automatico" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Hora de ejecucion:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding MaintenanceTime}" IsEnabled="{Binding AutomaticMaintenanceEnabled}" Width="100" Style="{StaticResource TextBoxBase}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Centro de Notificaciones" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <CheckBox IsChecked="{Binding SecurityAlertsEnabled}" Content="Alertas de seguridad" Margin="0,0,0,8"/>
                    <CheckBox IsChecked="{Binding SystemStatusReportsEnabled}" Content="Informes de actualizacion y salud de hardware" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding SettingsMessage}" FontSize="12" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Button Content="Guardar Programacion" Command="{Binding SaveConfigCommand}" Style="{StaticResource ButtonPrimary}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Correo SMTP para recuperacion" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Servidor SMTP" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SmtpServer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxBase}"/>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,8">
                            <TextBlock Text="Puerto" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxBase}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Usuario SMTP" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SmtpUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxBase}"/>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,8">
                            <TextBlock Text="Contrasena o app password" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SmtpPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxBase}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Correo remitente" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SmtpFromEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxBase}"/>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,8">
                            <TextBlock Text="Nombre remitente" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SmtpFromName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxBase}"/>
                        </StackPanel>
                    </UniformGrid>
                    <CheckBox IsChecked="{Binding SmtpEnableSsl}" Content="Usar SSL/TLS" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding SmtpMessage}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{Binding SmtpMessage, Converter={StaticResource MessageToBrushConverter}}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Guardar SMTP" Command="{Binding SaveSmtpCommand}" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left"/>
                        <Button Content="Enviar prueba" Command="{Binding SendTestEmailCommand}" Style="{StaticResource ButtonSecondary}" Margin="8,0,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Seguridad de Acceso" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Contrasena actual" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="CurrentPwd" Style="{StaticResource PasswordBoxBase}" Margin="0,0,0,8" PasswordChanged="CurrentPwd_PasswordChanged"/>
                    <TextBlock Text="Nueva contrasena" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="NewPwd" Style="{StaticResource PasswordBoxBase}" Margin="0,0,0,8" PasswordChanged="NewPwd_PasswordChanged"/>
                    <TextBlock Text="Confirmar nueva contrasena" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="ConfirmPwd" Style="{StaticResource PasswordBoxBase}" Margin="0,0,0,8" PasswordChanged="ConfirmPwd_PasswordChanged"/>
                    <TextBlock Text="{Binding PasswordMessage}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{Binding PasswordMessage, Converter={StaticResource MessageToBrushConverter}}"/>
                    <Button Content="Cambiar Contrasena" Command="{Binding ChangePasswordCommand}" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Version y Actualizaciones" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding AppVersion, StringFormat='Version: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button Content="Buscar Actualizaciones" Command="{Binding CheckUpdatesCommand}" Style="{StaticResource ButtonSecondary}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
