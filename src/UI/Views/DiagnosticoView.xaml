<UserControl x:Class="JSL_SentinelPro.src.UI.Views.DiagnosticoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Diagnostico de Hardware" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <!-- Barra de progreso de escaneo -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Escaneo de Componentes" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ProgressBar Value="{Binding ScanProgress, Mode=OneWay}" Maximum="100" Height="20" Margin="0,0,0,8"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="{Binding ComponentsAnalyzed, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding TotalComponents, Mode=OneWay}"/><Run Text=" componentes analizados"/>
                    </TextBlock>
                    <TextBlock Text="{Binding TimeRemaining, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{Binding IsScanning, Converter={StaticResource ScanningToButtonTextConverter}}"
                                Command="{Binding StartScanCommand}" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="Reconoce tu PC"
                                Command="{Binding RecognizePcCommand}" Style="{StaticResource ButtonSecondary}" Margin="8,0,0,0" HorizontalAlignment="Left"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- CPU -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12"
                    Visibility="{Binding HasScanResults, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Procesador" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding CpuInfo.Name, Mode=OneWay}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding CpuInfo.Status, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <TextBlock><Run Text="Nucleos: "/><Run Text="{Binding CpuInfo.CoreCount, Mode=OneWay}"/></TextBlock>
                        <TextBlock><Run Text="Hilos: "/><Run Text="{Binding CpuInfo.ThreadCount, Mode=OneWay}"/></TextBlock>
                        <TextBlock><Run Text="Uso: "/><Run Text="{Binding CpuInfo.UsagePercent, StringFormat='{}{0:F1}%', Mode=OneWay}"/></TextBlock>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- RAM -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12"
                    Visibility="{Binding HasScanResults, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Memoria RAM" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock FontSize="14">
                        <Run Text="{Binding MemoryInfo.UsedGB, StringFormat='{}{0:F2} GB', Mode=OneWay}"/><Run Text=" usados de "/><Run Text="{Binding MemoryInfo.TotalGB, StringFormat='{}{0:F2} GB', Mode=OneWay}"/>
                    </TextBlock>
                    <ProgressBar Value="{Binding MemoryInfo.UsagePercent, Mode=OneWay}" Maximum="100" Height="10" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding MemoryInfo.Status, Mode=OneWay}" FontSize="12" Margin="0,4,0,0" Foreground="{Binding MemoryInfo.Status, Converter={StaticResource StatusToBrushConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Discos -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12"
                    Visibility="{Binding HasScanResults, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Almacenamiento" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Disks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6">
                                    <TextBlock FontSize="13" FontWeight="SemiBold">
                                        <Run Text="{Binding DriveLetter, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Label, Mode=OneWay}"/><Run Text=" ("/><Run Text="{Binding DriveType, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                    <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,4"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding UsedGB, StringFormat='{}{0:F1} GB', Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding TotalGB, StringFormat='{}{0:F1} GB', Mode=OneWay}"/><Run Text=" - "/><Run Text="{Binding Status, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Temperaturas -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12"
                    Visibility="{Binding HasScanResults, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Temperaturas" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding Temperatures}" Style="{StaticResource DataGridBase}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="250">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hardware" Binding="{Binding HardwareName}" Width="200"/>
                            <DataGridTextColumn Header="Sensor" Binding="{Binding SensorName}" Width="180"/>
                            <DataGridTextColumn Header="Temp C" Binding="{Binding ValueCelsius, StringFormat='{}{0:F1}'}" Width="80"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding StatusColor, Converter={StaticResource StringToBrushConverter}}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Recomendaciones -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12"
                    Visibility="{Binding HasScanResults, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Recomendaciones Preventivas" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Historial -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Historial de Escaneos" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding ScanHistory}" Style="{StaticResource DataGridBase}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding ScanDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
                            <DataGridTextColumn Header="CPU%" Binding="{Binding CpuUsage, StringFormat='{}{0:F1}'}" Width="80"/>
                            <DataGridTextColumn Header="RAM GB" Binding="{Binding RamUsedBytes, Converter={StaticResource BytesToGBConverter}}" Width="100"/>
                            <DataGridTextColumn Header="Temp C" Binding="{Binding MaxTemperature, StringFormat='{}{0:F1}'}" Width="80"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
