<UserControl x:Class="JSL_SentinelPro.src.UI.Views.PasswordResetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
            <TextBlock Text="JSL" FontSize="36" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="SISTEMA INTEGRAL DE SEGURIDAD" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,20"/>

            <Border Style="{StaticResource CardStyle}" Padding="32">
                <StackPanel>
                    <TextBlock Text="Restablecer Contrasena" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Aqui puedes restablecer tu contrasena de forma segura para recuperar el acceso a tu cuenta." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="Correo electronico corporativo" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxBase}" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding Message}" Foreground="{Binding IsSuccess, Converter={StaticResource BoolToBrushConverter}}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Button Content="Enviar codigo de recuperacion" Command="{Binding SendCodeCommand}" Style="{StaticResource ButtonPrimary}" Margin="0,0,0,8" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Hyperlink Command="{Binding NavigateToConfirmCommand}">
                            <TextBlock Text="Ya tengo un codigo" FontSize="12" Foreground="{StaticResource PrimaryBrush}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Hyperlink Command="{Binding NavigateToLoginCommand}">
                            <TextBlock Text="← Volver al inicio de sesion" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource InfoBackgroundBrush}" CornerRadius="6,6,6,6" Padding="8,4" HorizontalAlignment="Center" Margin="0,16,0,0">
                <TextBlock Text="Autenticacion cifrada AES-256 activa" FontSize="11" Foreground="{StaticResource InfoBrush}"/>
            </Border>
        </StackPanel>

        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="AYUDA" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0"/>
                <TextBlock Text="|" FontSize="11" Foreground="{StaticResource BorderBrush}"/>
                <TextBlock Text="PRIVACIDAD" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0"/>
                <TextBlock Text="|" FontSize="11" Foreground="{StaticResource BorderBrush}"/>
                <TextBlock Text="TERMINOS" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
