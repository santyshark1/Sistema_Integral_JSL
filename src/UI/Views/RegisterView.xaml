<UserControl x:Class="JSL_SentinelPro.src.UI.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PrimaryLightBrush}">
            <StackPanel VerticalAlignment="Center" Margin="40">
                <TextBlock Text="JSL" FontSize="36" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Protección Inteligente para tu computador" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,20,0,8"/>
                <TextBlock Text="Únete a la plataforma de diagnóstico preventivo y ciberseguridad avanzada." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <StackPanel Margin="0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <Ellipse Width="32" Height="32" Fill="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="Monitoreo de Hardware en Tiempo Real" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <Ellipse Width="32" Height="32" Fill="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="Escaneo de Amenazas" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <Ellipse Width="32" Height="32" Fill="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="Seguridad Avanzada" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Versión de evaluación gratuita por 30 días" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40" VerticalAlignment="Center">
                <TextBlock Text="Crear Nueva Cuenta" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Regístrate para acceder a todas las funcionalidades del sistema" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20"/>

                <TextBlock Text="Nombre completo" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxBase}" Margin="0,0,0,10"/>

                <TextBlock Text="Correo electrónico" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxBase}" Margin="0,0,0,10"/>

                <TextBlock Text="Usuario" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxBase}" Margin="0,0,0,10"/>

                <TextBlock Text="Tipo de cuenta" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox SelectedValue="{Binding AccountType}" SelectedValuePath="Content" Style="{StaticResource ComboBoxBase}" Margin="0,0,0,10">
                    <ComboBoxItem Content="Usuario estandar"/>
                    <ComboBoxItem Content="Administrador"/>
                </ComboBox>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Contraseña" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <CheckBox Content="Ver" IsChecked="{Binding ShowPassword}" Margin="12,0,0,0" Checked="ShowPassword_Checked" Unchecked="ShowPassword_Checked"/>
                </StackPanel>
                <Grid Margin="0,0,0,10">
                    <PasswordBox x:Name="RegPassword" Style="{StaticResource PasswordBoxBase}" PasswordChanged="RegPassword_PasswordChanged"
                                 Visibility="{Binding ShowPassword, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBox x:Name="RegPasswordText" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxBase}"
                             Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>

                <TextBlock Text="Confirmar contraseña" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <PasswordBox x:Name="RegConfirm" Style="{StaticResource PasswordBoxBase}" PasswordChanged="RegConfirm_PasswordChanged"
                                 Visibility="{Binding ShowPassword, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBox x:Name="RegConfirmText" Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxBase}"
                             Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>

                <CheckBox IsChecked="{Binding AcceptTerms}" Margin="0,0,0,10" Content="Acepto los términos y condiciones de servicio"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                <Button Content="Registrarse" Command="{Binding RegisterCommand}" Style="{StaticResource ButtonPrimary}" Margin="0,0,0,8" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Content="← Volver al inicio de sesión" Command="{Binding NavigateToLoginCommand}" Style="{StaticResource ButtonSecondary}" Margin="0,4,0,0"/>

                <TextBlock Text="Seguridad de datos garantizada mediante protocolos de encriptación end-to-end"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
